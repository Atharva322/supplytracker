# Server Configuration
server.port=8080
cors.allowed.origins=${CORS_ORIGINS:http://localhost:5173,http://localhost:5174,http://localhost:3000}

# JWT Configuration
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION_MS:900000}
app.bootstrap-admin.enabled=${BOOTSTRAP_ADMIN_ENABLED:false}
app.bootstrap-admin.username=${BOOTSTRAP_ADMIN_USERNAME:admin}
app.bootstrap-admin.email=${BOOTSTRAP_ADMIN_EMAIL:admin@supplytracker.local}
app.bootstrap-admin.password=${BOOTSTRAP_ADMIN_PASSWORD:}

# YOLO Detection Service
yolo.service.url=${YOLO_SERVICE_URL:http://localhost:8000}

# Asynchronous inspection pipeline
inspection.worker.enabled=${INSPECTION_WORKER_ENABLED:false}
inspection.worker.fixed-delay-ms=${INSPECTION_WORKER_FIXED_DELAY_MS:5000}
inspection.worker.max-attempts=${INSPECTION_WORKER_MAX_ATTEMPTS:3}
inspection.worker.retry-backoff-seconds=${INSPECTION_WORKER_RETRY_BACKOFF_SECONDS:30}
inspection.upload.max-size-bytes=${INSPECTION_UPLOAD_MAX_SIZE_BYTES:10485760}
inspection.upload.local-base-url=${INSPECTION_UPLOAD_LOCAL_BASE_URL:/api/v2/inspection-uploads}
inspection.upload.local-root=${INSPECTION_UPLOAD_LOCAL_ROOT:./data/inspection-uploads}
inspection.inference.connect-timeout-ms=${INSPECTION_INFERENCE_CONNECT_TIMEOUT_MS:5000}
inspection.inference.read-timeout-ms=${INSPECTION_INFERENCE_READ_TIMEOUT_MS:60000}
inspection.model.version=${INSPECTION_MODEL_VERSION:local-yolo-placeholder}
inspection.dataset.version=${INSPECTION_DATASET_VERSION:unversioned-local-dev}
inspection.preprocessing.version=${INSPECTION_PREPROCESSING_VERSION:preprocess-local-v1}
inspection.label-map.version=${INSPECTION_LABEL_MAP_VERSION:coco-local-v1}
inspection.threshold.version=${INSPECTION_THRESHOLD_VERSION:thresholds-local-v1}
inspection.review.confidence-threshold=${INSPECTION_REVIEW_CONFIDENCE_THRESHOLD:0.60}
inspection.scoring.profile-version=${INSPECTION_SCORING_PROFILE_VERSION:calibrated-local-v1}
inspection.scoring.product-thresholds=${INSPECTION_SCORING_PRODUCT_THRESHOLDS:Fruits:0.72,Vegetables:0.68}
inspection.policy-sensitive-labels=${INSPECTION_POLICY_SENSITIVE_LABELS:}

# Lineage and recall traversal
lineage.traversal.max-depth=${LINEAGE_TRAVERSAL_MAX_DEPTH:12}
lineage.traversal.max-nodes=${LINEAGE_TRAVERSAL_MAX_NODES:1000}

# MongoDB Configuration
spring.data.mongodb.uri=${SPRING_DATA_MONGODB_URI:mongodb://localhost:27018/agriproj?directConnection=true}
spring.data.mongodb.auto-index-creation=true

# GraphQL Configuration
spring.graphql.graphiql.enabled=true
spring.graphql.graphiql.path=/graphiql
spring.graphql.path=/graphql
spring.graphql.websocket.path=/graphql
spring.graphql.schema.printer.enabled=true

# Redis is present in the local infrastructure stack but is not wired into the
# Spring application yet. Redis integration is deferred to a later platform phase.

# Actuator Configuration
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=when_authorized
management.metrics.export.prometheus.enabled=true
management.metrics.distribution.percentiles-histogram.http.server.requests=true

# Application Info
info.app.name=SupplyTracker
info.app.version=1.0-SNAPSHOT
info.app.description=Agricultural Supply Chain Tracker

# Logging Configuration
logging.level.root=INFO
logging.level.com.agri.supplytracker=DEBUG
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n
logging.file.name=logs/supplytracker.log
logging.file.max-size=10MB
logging.file.max-history=30

# File Upload Configuration
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# AWS Configuration
aws.region=us-east-2
aws.s3.bucket=your-s3-bucket-name

# AWS Bedrock Configuration
aws.bedrock.model-id=amazon.nova-lite-v1:0
aws.bedrock.max-tokens=300
aws.bedrock.region=us-east-2

# Google OAuth2 Configuration
spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
spring.security.oauth2.client.registration.google.redirect-uri=http://localhost:8080/login/oauth2/code/google
spring.security.oauth2.client.registration.google.scope=profile,email
spring.security.oauth2.client.registration.google.authorization-grant-type=authorization_code
spring.security.oauth2.client.provider.google.authorization-uri=https://accounts.google.com/o/oauth2/auth
spring.security.oauth2.client.provider.google.token-uri=https://oauth2.googleapis.com/token
spring.security.oauth2.client.provider.google.user-info-uri=https://www.googleapis.com/oauth2/v3/userinfo
spring.security.oauth2.client.provider.google.user-name-attribute=sub

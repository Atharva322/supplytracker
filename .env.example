# Copy to .env for local tooling. Never commit .env.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=900000
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@supplytracker.local
BOOTSTRAP_ADMIN_PASSWORD=
SPRING_DATA_MONGODB_URI=mongodb://localhost:27018/agriproj?directConnection=true
YOLO_SERVICE_URL=http://localhost:8000
INSPECTION_WORKER_ENABLED=false
INSPECTION_WORKER_FIXED_DELAY_MS=5000
INSPECTION_WORKER_MAX_ATTEMPTS=3
INSPECTION_WORKER_RETRY_BACKOFF_SECONDS=30
INSPECTION_UPLOAD_MAX_SIZE_BYTES=10485760
INSPECTION_UPLOAD_LOCAL_ROOT=./data/inspection-uploads
INSPECTION_INFERENCE_CONNECT_TIMEOUT_MS=5000
INSPECTION_INFERENCE_READ_TIMEOUT_MS=60000
INSPECTION_MODEL_VERSION=local-yolo-placeholder
INSPECTION_DATASET_VERSION=unversioned-local-dev
INSPECTION_PREPROCESSING_VERSION=preprocess-local-v1
INSPECTION_LABEL_MAP_VERSION=coco-local-v1
INSPECTION_THRESHOLD_VERSION=thresholds-local-v1
INSPECTION_REVIEW_CONFIDENCE_THRESHOLD=0.60
INSPECTION_SCORING_PROFILE_VERSION=calibrated-local-v1
INSPECTION_SCORING_PRODUCT_THRESHOLDS=Fruits:0.72,Vegetables:0.68
INSPECTION_POLICY_SENSITIVE_LABELS=
LINEAGE_TRAVERSAL_MAX_DEPTH=12
LINEAGE_TRAVERSAL_MAX_NODES=1000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis is provisioned by the current infrastructure files but is not yet used
# by the Spring cache manager. These values are reserved for the integration phase.
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend and local service URLs
VITE_API_URL=http://localhost:8080/api
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Operations dashboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password
GRAFANA_URL=http://localhost:3000

# Optional model overrides. Defaults resolve under yolov3-service/models/.
YOLO_CFG_PATH=
YOLO_WEIGHTS_PATH=
